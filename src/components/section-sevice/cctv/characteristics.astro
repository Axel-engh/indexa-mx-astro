---
import {
    FileMinusCorner,
    ZoomIn,
    Lock,
    FileText,
    Settings,
    Users,
} from "lucide-astro";
---

<section
    class="p-6 md:px-[250px] w-[100%] h-[100%] md:h-[100%] bg-[url('/img/background.webp')] bg-cover bg-center bg-no-repeat opacity-0 translate-y-4 animate-[fadeUp_0.6s_ease-out_forwards]"
>
    <div>
        <div class="grid text-center justify-center gap-[20px] mb-[7%] mt-[7%]">
             <div class="inline-flex justify-center">
                <span
                    class="px-6 py-2 rounded-full bg-gray-100 text-sm font-medium"
                >
                    DIGITALIZACIÓN
                </span>
            </div>

            <h2
                class="text-[32px] text-white border-l-4 border-[var(--secondary)]"
            >
                Características
            </h2>
            <p class="text-[16px] text-white">
                ¿Por qué confiar en Indexa Digital?
            </p>
        </div>
        <div
            class="grid gap-[30px] md:flex-column md:flex mb-[10%] gap-[6%] text-white"
        >
            <div
                class="w-full h-auto md:w-[40%] md:h-[300px] place-items-center place-content-center text-center bg-black/20 backdrop-blur-md rounded-[25px] border-[var(--secondary)] transition-all duration-200 md:hover:w-[50%] md:hover:-translate-y-6 md:hover:border-l-[6px]"
            >
                <div
                    class="aspect-square w-[20%] border-4 border-white rounded-full flex justify-center items-center"
                >
                    <FileMinusCorner class="w-[50%] h-[50%]" />
                </div>
                <h3 class="text-[24px]">Ahorro</h3>
                <p class="text-[16px]">
                    Sustituimos sus documentos físicos por digitales, logrando
                    una disminución en el consumo de papel.
                </p>
            </div>
            <div
                class="w-full h-auto md:w-[40%] md:h-[300px] place-items-center place-content-center text-center bg-black/20 backdrop-blur-md rounded-[25px] border-[var(--secondary)] transition-all duration-200 md:hover:w-[50%] md:hover:-translate-y-6 md:hover:border-l-[6px]"
            >
                <div
                    class="aspect-square w-[20%] border-4 border-white rounded-full flex justify-center items-center"
                >
                    <ZoomIn class="w-[50%] h-[50%]" />
                </div>
                <h3 class="text-[24px]">Consulta</h3>
                <p class="text-[16px]">
                    Acceda y consulte sus documentos digitales desde cualquier
                    lugar y en múltiples dispositivos.
                </p>
            </div>
            <div
                class="w-full h-auto md:w-[40%] md:h-[300px] place-items-center place-content-center text-center bg-black/20 backdrop-blur-md rounded-[25px] border-[var(--secondary)] transition-all duration-200 md:hover:w-[50%] md:hover:-translate-y-6 md:hover:border-l-[6px]"
            >
                <div
                    class="aspect-square w-[20%] border-4 border-white rounded-full flex justify-center items-center"
                >
                    <Lock class="w-[50%] h-[50%]" />
                </div>
                <h3 class="text-[24px]">Seguridad</h3>
                <p class="text-[16px]">
                    Mitigamos el extravió de documentos, con el versionamiento
                    de su acervo digital.
                </p>
            </div>
        </div>
        <div
            class="grid gap-[30px] md:flex-column md:flex mb-[10%] gap-[6%] text-white"
        >
            <div
                class="w-full h-auto md:w-[40%] md:h-[300px] place-items-center place-content-center text-center bg-black/20 backdrop-blur-md rounded-[25px] border-[var(--secondary)] transition-all duration-200 md:hover:w-[50%] md:hover:-translate-y-6 md:hover:border-l-[6px]"
            >
                <div
                    class="aspect-square w-[20%] border-4 border-white rounded-full flex justify-center items-center"
                >
                    <FileText class="w-[50%] h-[50%]" />
                </div>
                <h3 class="text-[24px]">Formatos</h3>
                <p class="text-[16px]">
                    Almacenamos su acervo digital en múltiples formatos (.PDF,
                    .DOC, etc.).
                </p>
            </div>
            <div
                class="w-full h-auto md:w-[40%] md:h-[300px] place-items-center place-content-center text-center bg-black/20 backdrop-blur-md rounded-[25px] border-[var(--secondary)] transition-all duration-200 md:hover:w-[50%] md:hover:-translate-y-6 md:hover:border-l-[6px]"
            >
                <div
                    class="aspect-square w-[20%] border-4 border-white rounded-full flex justify-center items-center"
                >
                    <Settings class="w-[50%] h-[50%]" />
                </div>
                <h3 class="text-[24px]">Gestión</h3>
                <p class="text-[16px]">
                    Control total sobre su información con una gestión ágil y
                    precisa en cada uno de sus procesos.
                </p>
            </div>
            <div
                class="w-full h-auto md:w-[40%] md:h-[300px] place-items-center place-content-center text-center bg-black/20 backdrop-blur-md rounded-[25px] border-[var(--secondary)] transition-all duration-200 md:hover:w-[50%] md:hover:-translate-y-6 md:hover:border-l-[6px]"
            >
                <div
                    class="aspect-square w-[20%] border-4 border-white rounded-full flex justify-center items-center"
                >
                    <Users class="w-[50%] h-[50%]" />
                </div>
                <h3 class="text-[24px]">Simultaneidad</h3>
                <p class="text-[16px]">
                    Comparta, consulte y trabaje en colaboración sobre sus
                    documentos digitales.
                </p>
            </div>
        </div>
    </div>
</section>
